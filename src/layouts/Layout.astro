---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Cifras oficiales y canales verificados para ayudar tras el terremoto de Colombia de agosto de 2026.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · Terremoto Colombia 2026</title>
    <meta name="description" content={description} />
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') {
          document.documentElement.dataset.theme = theme;
        }
      } catch {
        // localStorage puede no estar disponible en algunos navegadores.
      }
    </script>
  </head>
  <body>
    <div class="wrap">
      <nav class="topnav">
        <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Inicio</a>
        <a href="/wiki/" aria-current={Astro.url.pathname.startsWith('/wiki') ? 'page' : undefined}>Wiki de ayuda</a>
        <a href="/sismos/" aria-current={Astro.url.pathname.startsWith('/sismos') ? 'page' : undefined}>Sismos</a>
        <a href="/reportar/" aria-current={Astro.url.pathname.startsWith('/reportar') ? 'page' : undefined}>Reportar algo</a>
        <a href="https://github.com/jdramirezzu/terremoto-colombia-2026" target="_blank" rel="noopener">Contribuir en GitHub ↗</a>
        <button type="button" class="theme-toggle" data-theme-toggle aria-label="Cambiar a tema oscuro">
          <span class="theme-toggle__icon theme-toggle__icon--sun" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="3.5" /><path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" /></svg>
          </span>
          <span class="theme-toggle__icon theme-toggle__icon--moon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false"><path d="M19.5 14.2A7.8 7.8 0 0 1 9.8 4.5 8.5 8.5 0 1 0 19.5 14.2Z" /></svg>
          </span>
          <span class="theme-toggle__thumb" aria-hidden="true"></span>
        </button>
      </nav>
      <main>
        <slot />
      </main>
      <footer class="site">
        Proyecto de código abierto, mantenido por voluntarios. La información
        se ofrece de buena fe pero puede contener errores — verifica siempre
        contra la fuente oficial citada en cada página antes de tomar una
        decisión, especialmente para donaciones económicas.
      </footer>
    </div>
  </body>
</html>

<script>
  const themeStorageKey = 'theme';

  function activarToggleTema() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    if (!toggle || toggle.dataset.ready === 'true') return;

    const root = document.documentElement;
    const temaActual = () => root.dataset.theme ?? (
      window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
    );
    const actualizarEstado = () => {
      const tema = temaActual();
      toggle.dataset.themeState = tema;
      toggle.setAttribute('aria-label', `Cambiar a tema ${tema === 'dark' ? 'claro' : 'oscuro'}`);
    };

    toggle.addEventListener('click', () => {
      const tema = temaActual() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = tema;
      actualizarEstado();
      try {
        localStorage.setItem(themeStorageKey, tema);
      } catch {
        // El tema sigue funcionando aunque no se pueda persistir.
      }
    });

    actualizarEstado();
    toggle.dataset.ready = 'true';
  }

  activarToggleTema();
  document.addEventListener('astro:page-load', activarToggleTema);
</script>
