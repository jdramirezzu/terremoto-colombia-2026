---
// Barras horizontales para comparar magnitud entre categorías nominales
// (departamentos). Un solo hue (--accent) — el objetivo es comparar
// cantidades, no distinguir identidad, así que no se le asigna un color
// distinto a cada barra (eso gastaría el canal de identidad en algo que
// el largo de la barra ya muestra).
interface Barra {
  nombre: string;
  valor: number;
  href?: string;
}

interface Props {
  barras: Barra[];
  titulo: string;
  id: string;
}

const { barras: barrasSinOrdenar, titulo, id } = Astro.props;
const barras = [...barrasSinOrdenar].sort((a, b) => b.valor - a.valor);
const max = Math.max(...barras.map((b) => b.valor)) || 1;
const formateador = new Intl.NumberFormat('es-CO');
---

<div class="grafico-barras" data-grafico-barras id={id}>
  <h3 class="grafico-titulo">{titulo}</h3>
  <div class="grafico-barras-lista">
    {barras.map((b) => {
      const pct = Math.max((b.valor / max) * 100, 3);
      return (
        <div class="grafico-barra-fila">
          {b.href ? (
            <a class="grafico-barra-nombre" href={b.href}>{b.nombre}</a>
          ) : (
            <span class="grafico-barra-nombre">{b.nombre}</span>
          )}
          <div class="grafico-barra-pista" tabindex="0" role="img" aria-label={`${b.nombre}: ${formateador.format(b.valor)}`} data-nombre={b.nombre} data-valor={formateador.format(b.valor)}>
            <div class="grafico-barra-relleno" style={`width: ${pct}%`}></div>
            <span class="grafico-barra-valor">{formateador.format(b.valor)}</span>
          </div>
        </div>
      );
    })}
  </div>
  <div class="grafico-tooltip" hidden></div>
  <details class="grafico-tabla">
    <summary>Ver como tabla</summary>
    <table>
      <thead>
        <tr><th>Departamento</th><th>Valor</th></tr>
      </thead>
      <tbody>
        {barras.map((b) => (
          <tr><td>{b.nombre}</td><td>{formateador.format(b.valor)}</td></tr>
        ))}
      </tbody>
    </table>
  </details>
</div>

<script>
  function activarGraficosBarras() {
    document.querySelectorAll<HTMLElement>('[data-grafico-barras]').forEach((contenedor) => {
      const tooltip = contenedor.querySelector<HTMLElement>('.grafico-tooltip');
      if (!tooltip) return;

      function mostrar(pista: HTMLElement) {
        const nombre = pista.dataset.nombre ?? '';
        const valor = pista.dataset.valor ?? '';
        tooltip!.innerHTML = '';
        const strong = document.createElement('strong');
        strong.textContent = valor;
        const span = document.createElement('span');
        span.textContent = nombre;
        tooltip!.append(strong, document.createElement('br'), span);
        tooltip!.hidden = false;

        const contRect = contenedor.getBoundingClientRect();
        const pistaRect = pista.getBoundingClientRect();
        tooltip!.style.left = `${pistaRect.left - contRect.left + pistaRect.width / 2}px`;
        tooltip!.style.top = `${pistaRect.top - contRect.top}px`;
      }
      function ocultar() {
        tooltip!.hidden = true;
      }

      contenedor.querySelectorAll<HTMLElement>('.grafico-barra-pista').forEach((pista) => {
        pista.addEventListener('pointerenter', () => mostrar(pista));
        pista.addEventListener('focus', () => mostrar(pista));
        pista.addEventListener('pointerleave', ocultar);
        pista.addEventListener('blur', ocultar);
      });
    });
  }
  activarGraficosBarras();
  document.addEventListener('astro:page-load', activarGraficosBarras);
</script>
