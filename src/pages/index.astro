---
import Layout from '../layouts/Layout.astro';
import StatTile from '../components/StatTile.astro';
import GraficoBarras from '../components/charts/GraficoBarras.astro';
import MapaRegiones from '../components/MapaRegiones.astro';
import { iconos } from '../lib/iconos';
import cifras from '../../data/cifras.json';
import regionesData from '../../data/regiones.json';

const corte = cifras.cortes[cifras.cortes.length - 1];

// Series de tiempo para los gráficos — se arma sola a partir de cifras.json,
// así que agregar un corte nuevo ahí (dato editorial) hace crecer el
// gráfico solo, sin tocar código. Se filtran los null: en una emergencia en
// curso no todos los cortes reportan las mismas cifras, y mostrar un hueco
// es más honesto que inventar un valor.
function serie(campo: 'fallecidos' | 'heridos' | 'desaparecidos') {
  return cifras.cortes
    .filter((c) => c[campo] !== null && c[campo] !== undefined)
    .map((c) => ({ etiqueta: c.etiqueta ?? c.fechaCorte, valor: c[campo] as number }));
}
// Solo los valores (para el sparkline de StatTile) — mismo filtro de null.
function historial(campo: 'fallecidos' | 'heridos' | 'desaparecidos') {
  return serie(campo).map((p) => p.valor);
}

// Desglose regional para el filtro — cada métrica trae su propia fecha de
// corte y fuente (no todas vienen del mismo momento, ver
// $schemaDesgloseRegional en cifras.json). Se le agrega una fecha legible
// acá para no repetir lógica de formateo en el cliente.
const desgloseRegional = Object.fromEntries(
  Object.entries(cifras.desgloseRegional).map(([metrica, info]) => [
    metrica,
    {
      ...info,
      fechaCorteLegible: new Date(info.fechaCorte).toLocaleDateString('es-CO', {
        day: 'numeric',
        month: 'short',
        timeZone: 'UTC',
      }),
    },
  ]),
);

// timeZone: 'UTC' evita que un build corrido en Colombia (UTC-5) muestre el
// día anterior — las fechas en cifras.json son solo-fecha, ancladas a
// medianoche UTC por el parser de Date.
const fechaCorte = new Date(corte.fechaCorte).toLocaleDateString('es-CO', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

// Desde el 14 de agosto hay más de un corte por día (6:30 a.m. y 9:00 a.m.,
// con cifras distintas), así que la fecha sola ya no identifica cuál se está
// mostrando — cuando la fuente declara la hora del corte, se muestra.
function horaLegible(hhmm: string | null) {
  if (!hhmm) return null;
  const [h, m] = hhmm.split(':').map(Number);
  const h12 = h % 12 === 0 ? 12 : h % 12;
  return `${h12}:${String(m).padStart(2, '0')} ${h < 12 ? 'a.m.' : 'p.m.'}`;
}
const horaCorte = horaLegible(corte.horaCorte);

// Avance forense — fuente y fecha propias, distintas a las de UNGRD (ver
// $schemaIdentificacionVictimas en cifras.json). Se muestra junto al bloque
// de "Personas" porque es lo que le sirve a una familia que está buscando a
// alguien, pero deliberadamente como nota y no como stat-tile: no es una
// cifra comparable con las de arriba.
const identificacion = cifras.identificacionVictimas;
const fechaIdentificacion = new Date(identificacion.fechaCorte).toLocaleDateString('es-CO', {
  day: 'numeric',
  month: 'long',
  timeZone: 'UTC',
});
const horaIdentificacion = horaLegible(identificacion.horaCorte);
const fmt = new Intl.NumberFormat('es-CO');

// grupo determina el color del ícono (ver .card-icono--* en global.css):
// urgente = reportar, material = ayuda económica/en especie,
// acompanamiento = pedir ayuda / voluntariado.
const wikiLinks = [
  { href: '/wiki/reportar-danos/', h: 'Reportar daños o desaparecidos', p: 'Líneas oficiales de reporte.', grupo: 'urgente' },
  { href: '/wiki/pedir-ayuda/', h: 'Pedir ayuda', p: 'Censo de damnificados, albergues, ayuda humanitaria.', grupo: 'acompanamiento' },
  { href: '/wiki/donar-dinero/', h: 'Donar dinero', p: 'Canales económicos, con link directo a cada entidad.', grupo: 'material' },
  { href: '/wiki/donar-especie/', h: 'Donar en especie', p: 'Centros de acopio y qué se necesita.', grupo: 'material' },
  { href: '/wiki/voluntariado/', h: 'Ser voluntario', p: 'Canales formales de voluntariado.', grupo: 'acompanamiento' },
];
---

<Layout title="Inicio">
  <div class="hero-panel">
    <h1>Terremoto de Colombia, agosto 2026</h1>
    <p class="hero-lead">
      Sismo de magnitud {cifras.evento.magnitud} el {new Date(cifras.evento.fecha).toLocaleDateString('es-CO', { day: 'numeric', month: 'long', timeZone: 'UTC' })} a
      las {cifras.evento.hora.slice(0, 5)}, epicentro en {cifras.evento.epicentro},
      a {cifras.evento.profundidadKm} km de profundidad. Afecta principalmente a{' '}
      {regionesData.departamentos.map((d, i) => (
        <>
          {i > 0 && (i === regionesData.departamentos.length - 1 ? ' y ' : ', ')}
          <a href={`/wiki/${d.slug}/`}>{d.nombre}</a>
        </>
      ))}
      .
    </p>
    <a class="pill-btn" href="#region">Elige tu departamento</a>

    <MapaRegiones departamentos={regionesData.departamentos} />
  </div>

  <div class="intro-grid">
    <div class="intro-card">
      <h2><span class="icono-linea" aria-hidden="true" set:html={iconos.buscar} /> Busco información o ayuda</h2>
      <ul>
        <li><a href="#cifras">Ver las cifras oficiales</a> del sismo.</li>
        <li><a href="/wiki/revisar-grietas/">¿Tu casa quedó con grietas?</a> Qué revisar y cuándo salir.</li>
        <li><a href="/sismos/">Actividad sísmica</a>: las réplicas registradas desde el 10 de agosto.</li>
        <li><a href="/wiki/">Wiki de canales nacionales</a>: reportar, pedir ayuda, donar, voluntariado.</li>
        <li><a href="#region">Elige tu departamento y ciudad</a> para canales locales (gobernación, alcaldía).</li>
      </ul>
    </div>
    <div class="intro-card">
      <h2><span class="icono-linea" aria-hidden="true" set:html={iconos.contribuir} /> Quiero contribuir</h2>
      <ul>
        <li>
          <a href="/reportar/">Reporta un dato mal o desactualizado</a> — sin necesitar cuenta de GitHub,
          en un formulario de 1 minuto.
        </li>
        <li>
          ¿Tienes cómo confirmar un canal contra su fuente oficial? Eso es lo que más
          necesitamos ahora mismo.
        </li>
        <li>
          <a href="https://github.com/jdramirezzu/terremoto-colombia-2026/blob/master/CONTRIBUTING.md" target="_blank" rel="noopener">
            Cómo contribuir código o contenido
          </a> directamente en GitHub.
        </li>
      </ul>
    </div>
    <div class="intro-card">
      <h2><span class="icono-linea" aria-hidden="true" set:html={iconos.directorio} /> Directorio comunitario de ayuda</h2>
      <p class="source-note" style="margin-top: 0;">
        Herramienta externa, no forma parte de este sitio ni pasa por nuestra
        revisión de canales oficiales.
      </p>
      <ul>
        <li>
          <a href="https://somoscolombia.app/" target="_blank" rel="noopener">somoscolombia.app ↗</a> —
          directorio comunitario para pedir o publicar ayuda por categoría (vivienda,
          alimentos, salud, mascotas, ingeniería, apoyo psicológico), con contacto
          directo por WhatsApp.
        </li>
        <li>
          Es un directorio abierto entre personas, no una entidad oficial — usa el
          mismo criterio que tendrías en cualquier contacto directo con un
          desconocido.
        </li>
      </ul>
    </div>
  </div>

  <div class="banner">
    <strong>Proyecto en construcción, mantenido por voluntarios.</strong>
    Cada canal indica si ya fue confirmado directamente con la entidad oficial o
    sigue pendiente de esa confirmación — revisa el badge antes de donar.
    <a href="/reportar/">¿Ves algo mal? Repórtalo aquí →</a>
  </div>

  <h2 id="cifras">Cifras oficiales — corte {fechaCorte}{horaCorte && `, ${horaCorte}`}</h2>

  <div class="filtro-region">
    <label for="filtro-cifras-select">Ver cifras de:</label>
    <select id="filtro-cifras-select">
      <option value="">Colombia (nacional)</option>
      {regionesData.departamentos.map((d) => <option value={d.nombre}>{d.nombre}</option>)}
    </select>
  </div>
  <p class="source-note" id="nota-filtro-cifras" hidden>
    Mostrando lo que tenemos para el departamento elegido. Cada cifra indica su
    propia fecha de corte — no todas vienen del mismo momento, y las que dicen
    <strong>"cifra nacional"</strong> es porque todavía no encontramos ese dato
    desagregado por departamento. ¿Lo tienes? <a href="/reportar/">Repórtalo</a>.
  </p>
  <script type="application/json" id="desglose-regional-data" set:html={JSON.stringify(desgloseRegional)} />

  <h3 class="subgrupo-titulo">Personas</h3>
  <div class="stat-grid stat-grid--personas">
    <StatTile label="Fallecidos" value={corte.fallecidos} serie={historial('fallecidos')} metric="fallecidos" />
    <StatTile label="Heridos" value={corte.heridos} serie={historial('heridos')} metric="heridos" />
    <StatTile label="Desaparecidos" value={corte.desaparecidos} serie={historial('desaparecidos')} metric="desaparecidos" />
    <StatTile label="Rescatados" value={corte.rescatados} metric="rescatados" />
    <StatTile label="Personas afectadas" value={corte.personasAfectadas} metric="personasAfectadas" />
  </div>

  <p class="source-note">
    <strong>Identificación de víctimas</strong> ({identificacion.fuente.split('—')[0].trim()},
    corte {fechaIdentificacion}{horaIdentificacion && `, ${horaIdentificacion}`}):
    {' '}{fmt.format(identificacion.cuerposRecibidos)} cuerpos recibidos,
    {' '}{fmt.format(identificacion.cuerposEntregados)} ya entregados a sus familias,
    {' '}{identificacion.menoresIdentificados} de ellos menores de edad.
    Este conteo va por una vía distinta al de la UNGRD y no tiene por qué cuadrar
    con la cifra de fallecidos: Medicina Legal solo cuenta los cuerpos que llegaron
    a sus instalaciones.
    {' '}<a href={identificacion.fuenteUrl} target="_blank" rel="noopener">Ver reporte ↗</a>
  </p>

  <h3 class="subgrupo-titulo">Infraestructura</h3>
  <div class="stat-grid stat-grid--infraestructura">
    <StatTile label="Viviendas destruidas" value={corte.viviendasDestruidas} metric="viviendasDestruidas" />
    <StatTile label="Viviendas averiadas" value={corte.viviendasAveriadas} metric="viviendasAveriadas" />
    <StatTile label="Edificios colapsados" value={corte.edificiosColapsados} metric="edificiosColapsados" />
    <StatTile label="Centros educativos afectados" value={corte.centrosEducativosAfectados} metric="centrosEducativosAfectados" />
    <StatTile label="Centros comunitarios afectados" value={corte.centrosComunitariosAfectados} metric="centrosComunitariosAfectados" />
    <StatTile label="Centros de salud afectados" value={corte.centrosSaludAfectados} metric="centrosSaludAfectados" />
  </div>

  {corte.departamentosAfectados && corte.municipiosAfectados && (
    <p class="source-note">
      <strong>Alcance de la emergencia en este corte:</strong> {corte.departamentosAfectados} departamentos
      y {corte.municipiosAfectados} municipios con afectación reportada. El filtro de
      arriba solo cubre los {regionesData.departamentos.length} departamentos más
      golpeados, que son para los que conseguimos cifras desagregadas — no son
      todos los afectados.
    </p>
  )}

  <p class="source-note">
    Fuente (cifras nacionales): {corte.fuente} — <a href={corte.fuenteUrl} target="_blank" rel="noopener">ver reporte ↗</a>.
    Los pequeños gráficos de "Personas" muestran los cortes anteriores — ver
    el detalle completo más abajo en "Cómo ha evolucionado".
  </p>

  <h2>Cómo ha evolucionado</h2>
  <p class="source-note">
    Cada punto es un corte oficial distinto, con su propia fuente (pasa el mouse o
    entra con teclado para ver el detalle). Es normal que algunas cifras bajen y
    otras suban entre un corte y el siguiente — así se ve una emergencia real
    mientras la información se va confirmando, no un error.
  </p>
  <div class="charts-grid">
    <GraficoBarras id="grafico-fallecidos" titulo="Fallecidos" puntos={serie('fallecidos')} color="var(--status-fallecidos)" />
    <GraficoBarras id="grafico-heridos" titulo="Heridos" puntos={serie('heridos')} color="var(--status-heridos)" />
    <GraficoBarras id="grafico-desaparecidos" titulo="Desaparecidos" puntos={serie('desaparecidos')} color="var(--accent)" />
  </div>

  <h2>Cómo ayudar</h2>
  <div class="card-grid">
    {wikiLinks.map((l) => (
      <a class="card" href={l.href}>
        <h3>
          <span class:list={['icono-linea', `card-icono--${l.grupo}`]} aria-hidden="true" set:html={iconos[l.grupo as keyof typeof iconos]} />
          {l.h}
        </h3>
        <p>{l.p}</p>
      </a>
    ))}
  </div>

  <h2 id="region"><span class="icono-linea" aria-hidden="true" set:html={iconos.pin} /> Ayuda por región</h2>
  <p class="source-note">
    Cada departamento tiene canales oficiales propios (gobernación, alcaldías) además
    de los nacionales de arriba — elige el tuyo.
  </p>
  <div class="card-grid">
    {regionesData.departamentos.map((d) => (
      <a class="card" href={`/wiki/${d.slug}/`}>
        <h3>{d.nombre}</h3>
        <p>Canales oficiales específicos de {d.nombre}.</p>
      </a>
    ))}
  </div>
</Layout>

<script>
  // Filtro de región para TODA la sección de cifras (Personas +
  // Infraestructura): NO es para comparar departamentos entre sí, es para
  // que alguien vea las cifras de su propio departamento. Genérico sobre
  // cualquier tile con data-metric — donde el desglose regional (embebido
  // más arriba como JSON) tiene dato para ese metric+departamento, se
  // actualiza el tile en el lugar; donde no, se queda en la cifra nacional
  // y se marca explícitamente como tal, para no fingir un desglose que no
  // existe.
  interface InfoMetrica {
    fechaCorte: string;
    fechaCorteLegible: string;
    fuente: string;
    valores: Record<string, number | null>;
    // Por qué falta (o por qué desconfiar de) el dato de un departamento
    // concreto. "No lo encontramos" y "la autoridad dice que todavía no
    // existe el conteo" no son lo mismo, y quien vive ahí merece saber cuál
    // de las dos es. Cuando hay nota, reemplaza al texto genérico.
    notas?: Record<string, string>;
  }

  function activarFiltroCifras() {
    const select = document.querySelector<HTMLSelectElement>('#filtro-cifras-select');
    const nota = document.querySelector<HTMLElement>('#nota-filtro-cifras');
    const datosEl = document.querySelector<HTMLScriptElement>('#desglose-regional-data');
    if (!select || !nota || !datosEl) return;

    const desglose = JSON.parse(datosEl.textContent || '{}') as Record<string, InfoMetrica>;
    const tiles = document.querySelectorAll<HTMLElement>('[data-metric]');
    const fmt = new Intl.NumberFormat('es-CO');

    select.addEventListener('change', () => {
      const depto = select!.value;
      nota!.hidden = !depto;

      tiles.forEach((tile) => {
        const metric = tile.dataset.metric ?? '';
        const valorEl = tile.querySelector<HTMLElement>('.value');
        const labelEl = tile.querySelector<HTMLElement>('.label');
        const tagEl = tile.querySelector<HTMLElement>('.region-tag');
        const labelNacional = tile.dataset.labelNacional ?? '';
        const valorNacional = tile.dataset.valueNacional ?? '';
        const nacionalTexto = valorNacional === '' ? '—' : fmt.format(Number(valorNacional));

        const restaurarNacional = () => {
          if (valorEl) valorEl.textContent = nacionalTexto;
          if (labelEl) labelEl.textContent = labelNacional;
          tile.classList.remove('regional-activo');
        };

        if (!depto) {
          restaurarNacional();
          if (tagEl) tagEl.hidden = true;
          return;
        }

        const infoMetrica = desglose[metric];
        const valorRegional = infoMetrica?.valores?.[depto];
        const nota = infoMetrica?.notas?.[depto];

        if (infoMetrica && valorRegional !== undefined && valorRegional !== null) {
          if (valorEl) valorEl.textContent = fmt.format(valorRegional);
          if (labelEl) labelEl.textContent = `${labelNacional} en ${depto}`;
          tile.classList.add('regional-activo');
          if (tagEl) {
            tagEl.hidden = false;
            // Hay dato regional, pero con reserva conocida (p. ej. un censo a
            // medias que lo deja corto): se marca en ámbar en vez del color de
            // acento, para que no se lea como una cifra cerrada.
            tagEl.className = nota ? 'region-tag region-tag--alerta' : 'region-tag';
            tagEl.textContent = nota
              ? `corte ${infoMetrica.fechaCorteLegible} · ${nota}`
              : `corte ${infoMetrica.fechaCorteLegible}`;
          }
        } else {
          restaurarNacional();
          if (tagEl) {
            tagEl.hidden = false;
            tagEl.className = 'region-tag region-tag--nacional';
            // La nota explica POR QUÉ falta, pero nunca reemplaza al aviso de
            // que el número grande sigue siendo el nacional: sin eso, la cifra
            // de Colombia se leería como la del departamento elegido.
            tagEl.textContent = nota
              ? `cifra nacional · ${nota}`
              : 'cifra nacional (sin desglose)';
          }
        }
      });
    });
  }
  activarFiltroCifras();
  document.addEventListener('astro:page-load', activarFiltroCifras);
</script>
