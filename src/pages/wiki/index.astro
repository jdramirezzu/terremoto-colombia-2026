---
import Layout from '../../layouts/Layout.astro';
import NotaVerificacion from '../../components/NotaVerificacion.astro';
import { getCollection } from 'astro:content';
import { parseWikiSlug } from '../../lib/wiki';
import { iconos } from '../../lib/iconos';
import regionesData from '../../../data/regiones.json';

const entries = await getCollection('wiki');
const nacionales = entries
  .filter((e) => parseWikiSlug(e.slug).ambito === 'nacional')
  .sort((a, b) => a.data.orden - b.data.orden);
---

<Layout title="Wiki de ayuda">
  <div class="page-intro">
    <h1>Wiki de canales oficiales</h1>
    <p>
      Cada entrada indica su fuente y quién la verificó por última vez. Si
      encuentras un dato desactualizado o un canal sospechoso, abre un issue
      en el repositorio — es la contribución más valiosa que puedes hacer
      ahora mismo.
    </p>
  </div>

  <div class="card-grid">
    {nacionales.map((entry) => (
      <a class="card" href={`/wiki/${entry.slug}/`}>
        <h3>{entry.data.titulo}</h3>
        <p>{entry.data.resumen}</p>
      </a>
    ))}
  </div>
  <NotaVerificacion entries={nacionales} />

  <h2><span class="icono-linea" aria-hidden="true" set:html={iconos.pin} /> Ayuda por región</h2>
  <p class="source-note">
    Elige tu departamento para ver también los canales oficiales locales
    (gobernación, alcaldía) además de los nacionales de arriba.
  </p>
  <div class="card-grid">
    {regionesData.departamentos.map((d) => (
      <a class="card" href={`/wiki/${d.slug}/`}>
        <h3>{d.nombre}</h3>
        <p>Canales oficiales específicos de {d.nombre}.</p>
      </a>
    ))}
  </div>
</Layout>
