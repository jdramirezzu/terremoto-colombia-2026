---
import Layout from '../../layouts/Layout.astro';
import FormularioReporte from '../../components/FormularioReporte.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('wiki');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
// Contenido regional vive bajo departamentos/<depto>/[<ciudad>/]<categoria> —
// mismo alcance que la ruta agregada de /wiki/<depto>/[<ciudad>]/, así que
// enlazamos de vuelta a esa vista en vez de solo al índice general.
const parts = entry.slug.split('/');
const backHref =
  parts[0] === 'departamentos'
    ? parts.length === 4
      ? `/wiki/${parts[1]}/${parts[2]}/`
      : `/wiki/${parts[1]}/`
    : '/wiki/';
// timeZone: 'UTC' evita que un build corrido en Colombia (UTC-5) muestre el
// día anterior — las fechas del front-matter son solo-fecha (sin hora), y
// coerce.date() las ancla a medianoche UTC.
const fecha = entry.data.fechaVerificacion.toLocaleDateString('es-CO', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<Layout title={entry.data.titulo} description={entry.data.resumen}>
  <p><a href={backHref}>← Volver</a></p>
  <h1>{entry.data.titulo}</h1>

  <div>
    {entry.data.estado === 'verificado' ? (
      <span class="verify-badge verify-badge--ok">✅ Verificado directamente con la fuente</span>
    ) : (
      <span class="verify-badge verify-badge--warn">⚠️ Sin verificar — borrador a partir de prensa</span>
    )}
    <span class="verify-badge">🕓 Última revisión: {fecha}</span>
    <span class="verify-badge">🔗 <a href={entry.data.fuente} target="_blank" rel="noopener">Fuente</a></span>
  </div>
  <p class="source-note">{entry.data.verificadoPor}</p>

  <Content />

  <FormularioReporte pagina={`/wiki/${entry.slug}/`} titulo="¿Este dato está mal o desactualizado?" />
</Layout>
